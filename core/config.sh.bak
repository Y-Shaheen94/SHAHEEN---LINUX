CYAN="\033[1;36m"; GREEN="\033[1;32m"; YELLOW="\033[1;33m"; MAGENTA="\033[1;35m"; NC="\033[0m"
#!/usr/bin/env bash

SHAHEEN_VERSION="1.0.0"
SHAHEEN_NAME="SHAHEEN"
SHAHEEN_PRONUNCIATION="SHAY-EN"
SHAHEEN_ABBR="SYN"
SHAHEEN_SIGNATURE="SΛYEN."
SHAHEEN_TITLE="THE SILENT SOVEREIGN"
SHAHEEN_SYMBOL="Λ"
